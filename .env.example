# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values.
#     cp .env.example .env     (Windows: copy .env.example .env)
# ".env" is git-ignored, ".env.example" is committed.
# ---------------------------------------------------------------------------

# Token from @BotFather (looks like 1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxx).
BOT_TOKEN=1234567890:AA_REPLACE_WITH_YOUR_REAL_BOT_TOKEN

# Your personal chat id, obtained from @userinfobot (a plain number, e.g. 987654321).
# In a group, use the negative id (e.g. -1001234567890).
ADMIN_CHAT_ID=987654321

# Optional. Leave it out (or comment it) to use https://api.telegram.org.
# Set it to the server root only when you run a local Bot API server or a test double.
# BOT_API_BASE_URL=http://127.0.0.1:8081
